[application]

config/name="Shadowborn Chapter 0"
config/icon="res://assets/branding/shadowborn_ios_icon.svg"
boot_splash/bg_color=Color(0.035294, 0.043137, 0.062745, 1)
boot_splash/show_image=false
run/main_scene="res://scenes/app/launch_shell.tscn"

[autoload]

PlatformRuntime="*res://scripts/platform/platform_runtime_service.gd"

[debug]

shadowborn/combat_trace_console=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/ios/allow_high_refresh_rate=false
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true
window/ios/suppress_ui_gesture=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_ticks_per_second=60
